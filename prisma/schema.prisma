generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("user")
  squad     Squad    @default(PROFESIONAL)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum Squad {
  PROFESIONAL
  SUB_20
  SUB_18
  SUB_17
  SUB_16
  SUB_15
}

enum Position {
  PORTERO
  DEFENSA
  MEDIOCAMPISTA
  DELANTERO
}

model Player {
  id        String   @id @default(cuid())
  name      String
  squad     Squad    @default(PROFESIONAL)
  position  Position @default(MEDIOCAMPISTA)
  photo     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  gpsDailyReports  GpsDailyReport[]
  gpsDailySessions GpsDailySession[]
  weeklyStats      WeeklyStat[]
  injuries         Injury[]

  @@unique([squad, name])
  @@index([squad])
  @@map("players")
}

model GpsDailySession {
  id             Int      @id @default(autoincrement())
  playerId       String   @map("player_id")
  date           DateTime
  sessionNumber  Int      @default(1) @map("session_number")
  year           Int      @default(0)
  weekNumber     Int      @default(0) @map("week_number")
  totalDistance  Float    @default(0) @map("total_distance")
  hsr            Float    @default(0)
  sprintDistance Float    @default(0) @map("sprint_distance")
  sprints        Int      @default(0)
  accelerations  Int      @default(0)
  decelerations  Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, date, sessionNumber])
  @@map("gps_daily_sessions")
}

model GpsDailyReport {
  id             Int      @id @default(autoincrement())
  playerId       String   @map("player_id")
  date           DateTime
  year           Int      @default(0)
  weekNumber     Int      @default(0) @map("week_number")
  totalDistance  Float    @map("total_distance") // meters
  hsr            Float    @default(0) // high speed running (meters)
  sprintDistance Float    @default(0) @map("sprint_distance") // meters
  sprints        Int      @default(0)
  accelerations  Int      @default(0)
  decelerations  Int      @default(0)
  maxSpeed       Float    @default(0) @map("max_speed") // km/h
  createdAt      DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, date])
  @@map("gps_daily_reports")
}

model WeeklyStat {
  id                Int    @id @default(autoincrement())
  playerId          String @map("player_id")
  year              Int
  weekNumber        Int    @map("week_number")
  totalDistance     Float  @map("total_distance") // meters (sum of daily)
  highVelocity      Float  @map("high_velocity") // HSR + Sprint Distance
  mechanicalImpacts Float  @map("mechanical_impacts") // Sprints + Acc + Dec

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, year, weekNumber])
  @@map("weekly_stats")
}

model Injury {
  id                    String   @id @default(cuid())
  playerId              String   @map("player_id")
  injuryType            String   @map("injury_type")
  severity              String
  dateOfInjury          DateTime @map("date_of_injury")
  estimatedRecoveryDays Int      @map("estimated_recovery_days")
  status                String
  description           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("injuries")
}
